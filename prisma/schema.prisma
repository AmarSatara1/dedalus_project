generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Report {
  id          String   @id @default(cuid())
  content     Json     @default("{}")
  patientAge  Int?
  patientName String   @default("")
  verified    Boolean  @default(false)  // Add this line
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
